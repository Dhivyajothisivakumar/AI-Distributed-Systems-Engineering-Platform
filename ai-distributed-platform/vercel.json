{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/((?!queue-consumer(?:/|$)).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/queue-consumer.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "distributed-tasks"
        }
      ]
    }
  }
}