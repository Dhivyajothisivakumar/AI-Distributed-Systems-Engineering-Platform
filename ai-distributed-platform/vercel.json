{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/queue-consumer.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "functions": {
    "api/queue-consumer.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "distributed-tasks"
        }
      ]
    }
  }
}